# Docker data directories
docker/mongodata/*
docker/pgdata/*
docker/pgdata_backup_*/*

# Keep .gitkeep files to maintain directory structure
!docker/mongodata/.gitkeep
!docker/pgdata/.gitkeep

# Environment variables and secrets
.env
.env.local
.env.development
.env.test
.env.production
*.env

# Docker build files
docker-build-*.log

# Docker compose override files (often contain local configurations)
docker-compose.override.yml

# Docker volume bind mounts
volumes/

# Docker temporary files
.dockerignore
docker/.tmp*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/

# IDE files
.idea/
.vscode/
*.swp
*.swo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System Files
.DS_Store
Thumbs.db
